# 复制为 .env 并填入真实值
# LLM 配置（日常对话与对话摘要使用；紧急检测/用药不依赖 LLM）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
# 可选：自定义兼容 OpenAI 协议的网关地址
# OPENAI_BASE_URL=https://api.openai.com/v1

# 数据库（默认本地 SQLite 文件）
DATABASE_URL=sqlite:///elder_care.db

# 未配置 key 时是否允许用离线模板回复（演示业务闭环用；true/false）
ALLOW_FAKE_LLM=true

# 语音层（后续启用，当前留骨架）
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
