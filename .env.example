# 复制为 .env 并填入真实值
# LLM 配置（日常对话与对话摘要使用；紧急检测/用药不依赖 LLM）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
# 可选：自定义兼容 OpenAI 协议的网关地址
# OPENAI_BASE_URL=https://api.openai.com/v1

# 数据库（默认本地 SQLite 文件）
DATABASE_URL=sqlite:///elder_care.db

# 未配置 key 时是否允许用离线模板回复（演示业务闭环用；true/false）
ALLOW_FAKE_LLM=true

# 联网搜索（火山联网搜索 API，用于天气/新闻等实时信息；不是方舟 LLM 接口）
# VOLCANO_API_KEY=
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_TIMEOUT_SEC=8
# WEB_SEARCH_COUNT=3

# 网页服务（demo.server）
# 注册默认需要一次性邀请码：python -m demo.invites new -n 5 生成；REGISTER_OPEN=true 才会开放注册（不推荐）
# 设置模式口令（默认 0000，务必修改）：对话里说“进入设置模式，口令xxxx”
# SETUP_PASSCODE=
# DATA_DIR=./data

# 语音层（后续启用，当前留骨架）
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
